# ============================================================
# Μαέρα & Διόνυσος — booking server configuration
# Copy this file to .env and fill in the values.
# The site works WITHOUT any of these — Stripe payments simply
# stay disabled and the booking form falls back to email requests.
# ============================================================

# Where the site is served from (used for Stripe redirect URLs)
SITE_URL=http://localhost:3000
PORT=3000

# --- Stripe (activate when the account is created) ---
# Use test keys (sk_test_/pk_test_) first, then switch to live keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe dashboard -> Developers -> Webhooks
# (endpoint: https://your-domain.com/api/webhook, event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# --- Confirmation emails (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Μαέρα & Διόνυσος <info@example.com>"
# Owner copy of every confirmation (BCC)
MAIL_OWNER=
