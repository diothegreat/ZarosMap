  "selectors": {
    "_comment": "Λίστες εναλλακτικών selectors. Δοκιμάζονται με τη σειρά. Αν αλλάξει η σελίδα login, διόρθωσέ τα εδώ (F12 → Inspect).",
    "cookie_accept": [
      "button:has-text('Alle akzeptieren')",
      "button:has-text('Accept all')",
      "button:has-text('Αποδοχή όλων')",
      "#uc-btn-accept-banner"
    ],
    "login_entry": [
      "button:has-text('Anmelden')",
      "a:has-text('Anmelden')",
      "button:has-text('Login')",
      "a:has-text('Login')",
      "button:has-text('Σύνδεση')"
    ],
    "username": ["#username", "input[name='username']", "input[type='email']", "#pw_usr"],
    "username_next": ["#pw_submit", "button[type='submit']", "button:has-text('Weiter')"],
    "password": ["#pw_pwd", "input[name='password']", "input[type='password']"],
    "password_submit": ["#pw_submit", "button[type='submit']", "button:has-text('Login')", "button:has-text('Anmelden')"],
    "logged_in_marker": ["[data-testid='profile']", "img[alt*='Profil']", "a[href*='profile']"]
  },

  "timeouts_ms": {
    "page": 30000,
    "element": 8000,
    "video": 45000
  }
